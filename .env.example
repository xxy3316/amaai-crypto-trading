# AI Trading System Environment Configuration
# Copy this file to .env and fill in your actual values

# ── Azure AI Foundry Configuration (primary) ──────────────────────────────
# Endpoint: copy from the Foundry portal. Any of these forms works:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT name you gave the model in Foundry (not always the model name).
# Verified working on this resource (fn-smartbot-stage), 2026-09-08:
#   chat:      gpt-5.4-nano  -> model gpt-5.4-nano-2026-03-17
#   embedding: text-embedding-ada-002, text-embedding-3-small (both dim 1536)
# NOT present here: gpt-4o, gpt-4o-mini (those live on the older rnd resource).
# Verified accepted by gpt-5.4-nano: temperature, JSON mode, tool calling.
# Rejected: max_tokens (the SDK sends max_completion_tokens instead).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Only needed if you use the vector-DB feature
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# 0 = deterministic, which is what a reproducible backtest wants
LLM_TEMPERATURE=0

# ── Phase 1: LLM participation in decisions ───────────────────────────────
# false = rules-only ablation arm (reproduces the old behaviour exactly)
USE_LLM_DECISIONS=true
# Max absolute adjustment the LLM may apply to the rule signal score
LLM_MAX_ADJUSTMENT=3

# ── Phase 2: research integrity guards ────────────────────────────────────
# Keep this false for any run you intend to publish.
ALLOW_SYNTHETIC_DATA=false
# next_open = fill at the next bar's open (realistic)
# same_close = fill at the decision bar's close (optimistic, ablation only)
EXECUTION_MODE=next_open
SLIPPAGE_PCT=0.05

# ── Phase 3: exogenous positioning signal (replaces the dead Twitter path) ──
# Source: https://data.binance.vision/data/futures/um/daily/metrics/
# Free, no API key, static files, byte-reproducible.
# Nothing to run by hand: `streamlit run auto-trade.py` downloads whatever the
# chosen date range needs on its first use and caches it.
# false = exogenous-signal-off ablation arm (reproduces the old behaviour)
USE_POSITIONING_SIGNAL=true
# Auto-download missing days during a run. Set false for a frozen offline run
# (the mode to use for the final numbers in a paper).
POSITIONING_AUTO_FETCH=true
# Max signal points positioning may add; 2 matches the weight of the RSI rule
POSITIONING_MAX_POINTS=2
# Extra bars of lag on top of the point-in-time cutoff. 1 = the bar opening at t
# sees only data published at or before t-1 bar, so positioning is lagged MORE
# than price (price already uses the bar's close). Never set this below 0.
POSITIONING_LAG_BARS=1
# Rolling window in BARS for the causal z-scores. 168 = one week of 1h bars.
# Used for sub-daily intervals (1h, 4h).
POSITIONING_ZSCORE_WINDOW=168
# Same window for 1d bars. 168 DAILY bars would need ~half a year of warmup
# history, which the cache does not have, so a daily run scored nothing at all
# and reported "usable on 0.0% of bars". 30 is about a month of baseline.
POSITIONING_ZSCORE_WINDOW_DAILY=30
# How often the system stops to make a decision, in HOURS. Converted to bars
# per interval, floored at one bar. 6h = every 6 bars on 1h, every bar on 1d.
DECISION_CADENCE_HOURS=6
# Where cached raw files and the provenance manifest live
EXOGENOUS_CACHE_ROOT=data/exogenous

# ── Phase 3: exogenous TEXT sentiment (real posts, replaces the dead one) ───
# Source: https://hn.algolia.com/api/v1/search_by_date  (Hacker News, keyless)
# Reddit / StockTwits / CryptoPanic are blocked by the corporate proxy and
# GDELT rate-limits its shared egress IP, so HN is what actually works here.
# Nothing to run by hand: the app downloads and caches what it needs.
# false = text-sentiment-off ablation arm
USE_TEXT_SENTIMENT=true
# vader = installed and instant. cryptobert = ElKulako/cryptobert, needs
# `pip install transformers torch`; falls back to vader with a warning.
TEXT_SENTIMENT_SCORER=vader
# Comma separated search terms. "btc" is excluded on purpose: it matched 1185
# documents in one day during probing, i.e. substring noise, not the asset.
TEXT_SENTIMENT_QUERIES=bitcoin,crypto
# Capped at 1 = HALF the positioning cap, because this is a single noisy
# feature that crosses 1 sigma on ~36% of bars while positioning averages three
# features and fires on ~15%. A stated prior, not a fitted parameter.
TEXT_SENTIMENT_MAX_POINTS=1
TEXT_SENTIMENT_LAG_BARS=1
# Trailing aggregation window; HN yields tens of docs a day, so a per-bar
# reading would be noise
TEXT_SENTIMENT_WINDOW_HOURS=24
TEXT_SENTIMENT_ZSCORE_WINDOW=168
# Below this many documents in the window, report "no reading" rather than act
TEXT_SENTIMENT_MIN_DOCS=5
# false = frozen offline run (use for the paper)
TEXT_SENTIMENT_AUTO_FETCH=true

# ── Public OpenAI (fallback, only used if the Azure vars above are empty) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Optional - for persistent storage)
DB_HOST=
DB_PORT=5432
DB_NAME=trading_results
DB_USER=
DB_PASSWORD=

# Trading Configuration
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
INITIAL_CAPITAL=10000
BUY_FEE_PCT=0.1
SELL_FEE_PCT=0.1
# NOTE: until 2026-09-11 these two were read by NOTHING; TradingConfig
# hard-coded buy=0.10 / sell=0.0, so every backtest exited free. They are
# now wired through core/config.py and cost 0.1% per side, matching
# Binance spot taker fees. Fixing it cut the golden window's return from
# 2.81% to 1.53%.


# Risk Management
MAX_POSITION_SIZE=0.3
STOP_LOSS_PCT=0.05
RISK_TOLERANCE=medium

# Technical Analysis
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50

# System Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
ENABLE_CACHING=true
